# Database Configuration (PostgreSQL through Supabase)
DATABASE_URL="postgresql://postgres.[project_ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project_ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase Authentication & API Configuration
SUPABASE_URL="https://[project_ref].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# AI Location Extraction & External Geocoding / Reports Configuration
GROQ_API_KEY="your-groq-api-key"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
REPORTS_SERVICE_URL="http://localhost:4000/api/v1/mock/reports"
CACHE_TTL_SECONDS=300

# Server & CORS Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
